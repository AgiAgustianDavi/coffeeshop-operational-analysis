      <column caption='Transaksi per hari' datatype='real' name='[Calculation_407575819288141825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([transaction_id]) / MIN([Calculation_407575819287941120])' />
      </column>
      <column caption='Item per hari' datatype='real' name='[Calculation_407575819290324994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity]) / MIN([Calculation_407575819287941120])' />
