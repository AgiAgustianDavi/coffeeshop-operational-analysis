                  <zone forceUpdate='true' h='23998' id='16' type-v2='text' w='42000' x='57385' y='69546'>
                    <formatted-text>
                      <run fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Rekomendasi</run>
                      <run>Æ&#10;&#10;</run>
                      <run fontcolor='#263238'>(1) </run>
                      <run bold='true' fontcolor='#263238'>Staf</run>
                      <run fontcolor='#263238'>: tim penuh senin-kamis jam 8, jumat jam 8 dan 12, serta sabtu-minggu jam 16-20; tim ramping di jam sepi.</run>
                      <run>Æ&#10;&#10;</run>
                      <run fontcolor='#263238'>(2) </run>
                      <run bold='true' fontcolor='#263238'>Stok</run>
                      <run fontcolor='#263238'>: ikuti jumlah pengunjung, pastikan es kopi susu gula aren cukup, kentang goreng cukup sedikit.</run>
                      <run>Æ&#10;&#10;</run>
                      <run fontcolor='#263238'>(3) </run>
                      <run bold='true' fontcolor='#263238'>Uji promo</run>
                      <run fontcolor='#263238'> kecil di jam sepi (sabtu-minggu pagi, senin-kamis sore) dan bandingkan dengan yang tanpa promo</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
